{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIMeeting",
  "version": "0.1.2",
  "identifier": "com.aimeeting.app",
  "build": {
    "beforeDevCommand": "npm.cmd run dev -- --host 127.0.0.1",
    "beforeBuildCommand": "npm.cmd run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AIMeeting",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 740,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
